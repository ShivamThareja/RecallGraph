# =============================================================================
# API key — passed to litellm.api_key, used as the fallback for all providers
# =============================================================================
LITELLM_API_KEY=your_api_key_here

# =============================================================================
# Custom LiteLLM proxy base URL (optional)
# Set this to route all calls through a LiteLLM proxy instead of provider APIs.
# Use model names like openai/<deployment> to match your proxy's model list.
# =============================================================================
# LITELLM_API_BASE=http://localhost:4000

# =============================================================================
# Models — LiteLLM format: provider/model-name
# =============================================================================
LLM_MODEL=gemini/gemini-2.5-flash
EMBEDDING_MODEL=gemini/gemini-embedding-001

# =============================================================================
# Reasoning effort (passed as reasoning_effort to litellm.completion)
# Gemini 2.5 values: none | low | medium | high
# none   — thinking disabled (cheapest)
# low    — budget_tokens=1024
# medium — budget_tokens=2048
# high   — budget_tokens=4096
# =============================================================================
REASONING_EFFORT=low

# =============================================================================
# FalkorDB
# =============================================================================
# FALKORDB_HOST=localhost
# FALKORDB_PORT=6379
# GRAPH_NAME=weavy

# =============================================================================
# Langfuse (optional observability)
# =============================================================================
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=http://localhost:3100

# =============================================================================
# Retrieval (optional — defaults shown)
# =============================================================================
# SEARCH_MAX_DISTANCE=0.6        # cosine distance cut-off for vector hits; "none" disables
# SEARCH_CANDIDATE_POOL=50       # candidates per pass before time filter + top-k
# SEARCH_EXPAND_DEPTH=1          # graph-neighbour expansion hops (0 = off)
# SEARCH_EXPAND_LIMIT=5          # max extra neighbour rows per search
# SEARCH_MAX_SOURCES=5           # source sessions listed per result
# NEIGHBORHOOD_LIMIT=25          # default get_node_neighborhood cap
